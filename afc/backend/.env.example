# Copy to .env  (PostgreSQL by default)
# ---- LOCAL DEVELOPMENT values ----
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=afc_db
DB_USER=afc_user
DB_PASSWORD=afc_pass
DB_HOST=127.0.0.1
DB_PORT=5432
# Set USE_SQLITE=1 only for a quick local test without PostgreSQL
USE_SQLITE=0
# customer site (5173) aur admin panel (5174) dono allowed
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- PRODUCTION: yeh sab zaroor badlo ----
# DEBUG=0
# SECRET_KEY=<lamba random string>  (python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
# ALLOWED_HOSTS=api.yourdomain.com
# DB_PASSWORD=<strong password>
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
# DJANGO_ADMIN_URL=   (khali = Django built-in admin band; ya koi secret path jaise x7k2-manage/)
